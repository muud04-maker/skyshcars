# Sky Cars V10 environment key template
# Put real values in Hostinger Environment Variables. Never commit real secrets.

# --- Database (required; already configured in production) ---
DB_HOST=srv737.hstgr.io
DB_PORT=3306
DB_NAME=u819138688_skycars
DB_USER=u819138688_skycars
DB_PASSWORD=CHANGE_ME

# --- Admin (required) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_12_CHARS_MINIMUM

# --- Website ---
NEXT_PUBLIC_SITE_URL=https://skyshcars.com
NEXT_PUBLIC_WHATSAPP_NUMBER=8615778025441

# --- AI / local WhatsApp service (required for your selected architecture) ---
DEEPSEEK_API_KEY=CHANGE_ME
# WHATSAPP_SERVICE_SECRET is not used by the current code (only needed if a separate local bridge is added later).
# DEEPSEEK_MODEL=deepseek-chat

# --- Meta WhatsApp Cloud API (optional when used) ---
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
# Recommended: add WHATSAPP_APP_SECRET for secure signature verification.
# V24 enters compatibility mode when it is missing so inbound messages do not stop.
# Set REQUIRE_WHATSAPP_SIGNATURE=true only after the app secret is present.
# Legacy aliases supported by existing integrations where implemented:
# VERIFY_TOKEN=CHANGE_ME
# WHATSAPP_TOKEN=CHANGE_ME
# PHONE_NUMBER_ID=CHANGE_ME

# --- Facebook Messenger (optional) ---
META_VERIFY_TOKEN=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_PAGE_ACCESS_TOKEN=CHANGE_ME

# WhatsApp media download / protected admin playback
WHATSAPP_GRAPH_VERSION=v26.0

# Facebook Page auto-posting
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0

# Social posting is enabled/disabled from /admin/social

# Optional: private partner inventory feed authentication
SUPPLIER_FEED_SECRET=

# V21 media intelligence (optional but required for automatic voice-note transcription and uncaptained photo understanding)
# Use either OPENAI_API_KEY or MEDIA_AI_API_KEY. Text sales replies continue to use DeepSeek.
OPENAI_API_KEY=
MEDIA_AI_API_KEY=
MEDIA_AI_BASE_URL=https://api.openai.com/v1
MEDIA_AI_TRANSCRIPTION_MODEL=whisper-1
MEDIA_AI_VISION_MODEL=gpt-4.1-mini

# Secure local/VPS WhatsApp group bridge -> website import endpoint
WHATSAPP_SERVICE_SECRET=
