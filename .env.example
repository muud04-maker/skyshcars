# Sky Cars V31 environment template
# Put real values in Hostinger Environment Variables. Never commit real secrets.

# --- Database ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Website ---
NEXT_PUBLIC_SITE_URL=https://skyshcars.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Sales AI ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Meta WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0
# Only set true after WHATSAPP_APP_SECRET is present.
REQUIRE_WHATSAPP_SIGNATURE=false

# --- Facebook Page / Messenger / auto-post ---
META_PAGE_ID=
# Preferred: a long-lived Page token (generated from a long-lived user token; it does not expire).
META_PAGE_ACCESS_TOKEN=
# Alternative to META_PAGE_ACCESS_TOKEN: a user token of a Page admin. With META_APP_ID + META_APP_SECRET it is
# exchanged for a long-lived token and the Page token is derived automatically at runtime.
META_USER_ACCESS_TOKEN=
# Optional but recommended: lets Admin show token expiry and posting permissions.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# --- Secure WhatsApp supplier Group Reader bridge ---
# Same value must be used in tools/whatsapp-group-bridge/.env
WHATSAPP_SERVICE_SECRET=

# --- Telegram V36 automatic inventory webhook ---
# Canonical names used by /api/integrations/telegram/webhook and Admin -> Telegram Automation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SOURCE_CHAT_ID=
# Optional; defaults to NEXT_PUBLIC_SITE_URL + /api/integrations/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# --- Automation cron (optional) ---
AUTOMATION_CRON_SECRET=

# --- Supplier feeds (optional) ---
SUPPLIER_FEED_SECRET=

# --- Voice-note transcription / image understanding (optional) ---
OPENAI_API_KEY=
MEDIA_AI_API_KEY=
MEDIA_AI_BASE_URL=https://api.openai.com/v1
MEDIA_AI_TRANSCRIPTION_MODEL=whisper-1
MEDIA_AI_VISION_MODEL=gpt-4.1-mini

# --- Private Lab ---
LAB_OWNER_EMAIL=
LAB_OWNER_PASSWORD=
LAB_PATH_FALLBACK=true

# --- Customer login (email + password, Google) ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Public site URL used for OAuth callbacks, e.g. https://skyshcars.com
AUTH_URL=
# Google sign-in (optional; button is hidden when empty). Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Website-only representative model imagery when exact stock photos are unavailable.
# Social publishing still uses exact approved stock photos only.
ALLOW_REPRESENTATIVE_MODEL_PHOTOS=true
