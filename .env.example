# --- AI / local WhatsApp service (required for your selected architecture) ---
DEEPSEEK_API_KEY=CHANGE_ME
# WHATSAPP_SERVICE_SECRET is not used by the current code (only needed if a separate local bridge is added later).
# DEEPSEEK_MODEL=deepseek-chat

# --- Meta WhatsApp Cloud API (optional when used) ---
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME
# REQUIRED for webhooks: unsigned Meta webhooks are rejected without WHATSAPP_APP_SECRET (or META_APP_SECRET).
# Temporary emergency switch only: ALLOW_UNSIGNED_WEBHOOKS=true
# Legacy aliases supported by existing integrations where implemented:
# VERIFY_TOKEN=CHANGE_ME
# WHATSAPP_TOKEN=CHANGE_ME
# PHONE_NUMBER_ID=CHANGE_ME

# --- Facebook Messenger (optional) ---
META_VERIFY_TOKEN=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_PAGE_ACCESS_TOKEN=CHANGE_ME

# WhatsApp media download / protected admin playback
WHATSAPP_GRAPH_VERSION=v26.0

# Facebook Page auto-posting
META_PAGE_ID=
