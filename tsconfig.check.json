    "target": "ES2020", "module": "commonjs", "moduleResolution": "node", "outDir": ".check-build", "rootDir": ".",
    "esModuleInterop": true, "skipLibCheck": true, "strict": false, "resolveJsonModule": true, "noEmit": false, "incremental": false
