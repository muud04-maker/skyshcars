SKY_CARS_URL=https://skyshcars.com
# Must exactly match WHATSAPP_SERVICE_SECRET in Hostinger. Never commit the real value.
WHATSAPP_SERVICE_SECRET=
BRIDGE_ID=primary

# Optional: quiet period (ms) that groups photos + caption from one supplier into one post. Default 20000.
POST_WINDOW_MS=20000

# 0 = persistent reader. Set to 10 for the optional hourly bounded timer.
# Use only one reader at a time for this WhatsApp account.
READER_WINDOW_MINUTES=0

# Persistent session, retry queue and recovered batch state. Keep outside the Git checkout.
STATE_DIR=/var/lib/skycars-group-reader

# Local-only QR status page. Reach it through an SSH tunnel; never bind it publicly.
QR_BIND_HOST=127.0.0.1
QR_PORT=3199
QR_ADMIN_TOKEN=
